# mwan3 配置：手机 USB 共享(usb0) 与物理网口(wan) 双 WAN 自动故障切换
#
# 由本仓库 files/ 提供，构建时进入镜像的 /etc/config/mwan3。
# 依赖：network.wan -> usb0、network.waneth -> wan（由 uci-defaults 脚本建立）
#
# 优先级：wan(usb0) 为主，waneth(网线) 为备。
# 与纯 metric 方案的区别：mwan3 做【健康探测】——定时 ping 目标，
# 失败达到阈值就把该线路标 down 并切换。这能覆盖 metric 方案无法处理的
# "链路 UP 但上游没网"场景。

config interface 'wan'
	option enabled '1'
	option family 'ipv4'
	option proto 'dhcp'
	option track_method 'ping'
	option reliability '1'
	option count '1'
	option size '56'
	option max_ttl '60'
	option check_quality '0'
	option timeout '4'
	option interval '10'
	option failure_latency '1000'
	option recovery_latency '500'
	option failure_loss '40'
	option recovery_loss '5'
	# 探测目标：阿里 DNS + 腾讯 DNS + Google DNS（国内可达性优先）
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	list track_ip '8.8.8.8'

config interface 'waneth'
	option enabled '1'
	option family 'ipv4'
	option proto 'dhcp'
	option track_method 'ping'
	option reliability '1'
	option count '1'
	option size '56'
	option max_ttl '60'
	option check_quality '0'
	option timeout '4'
	option interval '10'
	option failure_latency '1000'
	option recovery_latency '500'
	option failure_loss '40'
	option recovery_loss '5'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	list track_ip '8.8.8.8'

# 主备（failover）配置：
#   policy 'wan_only' 同时列出两个成员，mwan3 只会选用当前【在线】且
#   metric 最小的那个 —— 这正是主备语义：
#     wan(metric 1) 健康   -> 全程走 wan
#     wan 被判 down        -> 自动落到 waneth(metric 2)
#   两地网络互不干扰，也不需要负载均衡，所以不用 balanced。
config member 'wan_m1_w10'
	option interface 'wan'
	option metric '1'
	option weight '10'

config member 'waneth_m2_w10'
	option interface 'waneth'
	option metric '2'
	option weight '10'

# 主备策略（默认使用这个）
config policy 'wan_only'
	list use_member 'wan_m1_w10'
	list use_member 'waneth_m2_w10'

# 仅备用线路（手动切到网线时用）
config policy 'waneth_only'
	list use_member 'waneth_m2_w10'

# 仅主线路（手动切到手机时用）
config policy 'primary_only'
	list use_member 'wan_m1_w10'

# balanced 保留但不用（负载均衡会同时消耗手机流量，本部署不需要）
config policy 'balanced'
	list use_member 'wan_m1_w10'
	list use_member 'waneth_m2_w10'

# 默认规则：主备。wan 在线走 wan，wan 掉线自动走 waneth。
# wan_only 这个 policy 里同时含主备两个成员，mwan3 会跳过当前 down 的成员、
# 在健康成员中选 metric 最小的 —— 所以单靠这一条规则就实现了主备，
# 不需要再加一条指向备用 policy 的规则。
config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option family 'ipv4'
	option use_policy 'wan_only'
	option proto 'all'

config rule 'default_rule_v6'
	option dest_ip '::/0'
	option family 'ipv6'
	option use_policy 'wan_only'
	option proto 'all'

config globals 'globals'
	option mmx_mask '0x3F00'
	option rtmon_interval '5'
