#!/bin/sh
#
# AX6600 storage 数据分区预置（首次启动执行一次）
#
# 作用：把 eMMC 上那块 226 GiB 的 storage 分区准备好并开机自动挂载到 /mnt/storage。
#
# ⚠️ 安全设计（很重要）：
#   1. 分区已存在（带 PARTLABEL="storage"）→ 绝不重新创建、绝不格式化
#   2. 分区已存在且已有文件系统 → 绝不 mkfs（不会毁数据）
#   3. 只有"分区不存在"时才创建，只有"分区存在但没有文件系统"时才 mkfs
#   4. 任何一步失败都继续往下走，不会把开机流程卡死
#
# 背景：上游的 no-last-partition 分区表把 226 GiB 留在 GPT 之外，
#       扩展 GPT（sgdisk -e）后新建该分区。
#
# 挂载方式（2026-10-11 改）：
#   原先用自定义 /etc/init.d/storage 挂载，实测会和 OpenWrt 的 block 服务
#   打架 —— block 的 anon_mount 会先把它挂到 /mnt/mmcblk0p27，于是同一个
#   文件系统出现两个挂载点（/mnt/mmcblk0p27 和 /mnt/storage），容易误操作。
#
#   现在改用 OpenWrt 标准做法：
#     - fstab 里按【UUID】指定 target=/mnt/storage（分区号变了也不受影响）
#     - 关掉 anon_mount，避免再自动挂到 /mnt/<设备名>
#   由 block 服务（/etc/init.d/fstab，S11fstab）负责挂载，不再自建 init 脚本。

. /lib/functions.sh

PARTLABEL=storage
MOUNTDIR=/mnt/storage
FSTYPE=btrfs
FSLABEL=storage
DEV=/dev/mmcblk0

log() { echo "ax6600-storage: $*"; }

# ---------- 1) 找现有分区（优先 PARTLABEL，其次扫盘） ----------
find_part() {
	for p in /dev/disk/by-partlabel/$PARTLABEL; do
		[ -e "$p" ] && { echo "$p"; return 0; }
	done
	for p in ${DEV}p*; do
		[ -b "$p" ] || continue
		if blkid "$p" 2>/dev/null | grep -q "PARTLABEL=\"$PARTLABEL\""; then
			echo "$p"; return 0
		fi
	done
	return 1
}

PART=$(find_part)

# ---------- 2) 分区不存在就创建 ----------
if [ -z "$PART" ]; then
	log "未找到 $PARTLABEL 分区，尝试在 $DEV 上创建"
	if ! which sgdisk >/dev/null 2>&1; then
		log "缺少 sgdisk，跳过（需要 sgdisk 包）"
	else
		sgdisk -e "$DEV" >/dev/null 2>&1
		sgdisk -n 0:0:0 -c 0:$PARTLABEL \
		       -t 0:1B1720DA-A8BB-4B6F-92D2-0A93AB9609CA \
		       "$DEV" >/dev/null 2>&1
		sleep 2
		[ -w /sys/block/mmcblk0/device/rescan ] && echo 1 > /sys/block/mmcblk0/device/rescan 2>/dev/null
		sleep 2
		PART=$(find_part)
		if [ -z "$PART" ]; then
			log "创建失败，跳过本次（可稍后手动处理）"
		else
			log "已创建分区: $PART"
		fi
	fi
else
	log "分区已存在: $PART（不重建、不格式化）"
fi

# ---------- 3) 没有文件系统才格式化（有就绝对不动） ----------
if [ -n "$PART" ]; then
	CURFS=$(blkid -s TYPE -o value "$PART" 2>/dev/null)
	if [ -z "$CURFS" ]; then
		log "$PART 无文件系统，创建 $FSTYPE（卷标 $FSLABEL）"
		if which mkfs.btrfs >/dev/null 2>&1; then
			mkfs.btrfs -L "$FSLABEL" -f "$PART" >/dev/null 2>&1 && log "格式化完成" || log "格式化失败"
		else
			log "缺少 mkfs.btrfs，跳过（需要 btrfs-progs 包）"
		fi
	else
		log "$PART 已有文件系统 ($CURFS)，不格式化"
	fi
fi

# ---------- 4) 用 fstab 配置自动挂载（UUID 匹配，分区号变了也不怕） ----------
if [ -n "$PART" ]; then
	FSUUID=$(blkid -s UUID -o value "$PART" 2>/dev/null)
	if [ -z "$FSUUID" ]; then
		log "取不到 UUID，无法写 fstab，跳过"
	else
		# 关掉 anon_mount，避免 block 再把匿名卷挂到 /mnt/<设备名>
		# （同样不要用引号包值，否则会存成字面引号）
		ON=1
		OFF=0
		if ! uci -q get fstab.@global[0] >/dev/null 2>&1; then
			uci -q add fstab globals
		fi
		uci -q set "fstab.@global[0].anon_mount=$OFF"
		uci -q set "fstab.@global[0].anon_swap=$OFF"

		# 检查是否已有指向该 UUID 的挂载项
		# 注意：uci set 的赋值不要写成 "...enabled='1'" —— 双引号里的单引号
		# 会变成值的字面内容（实测存成 ''1''），这里用变量规避。
		ON=1
		EXIST=0
		i=0
		while uci -q get "fstab.@mount[$i]" >/dev/null 2>&1; do
			if [ "$(uci -q get fstab.@mount[$i].uuid)" = "$FSUUID" ]; then
				EXIST=1
				uci -q set "fstab.@mount[$i].target=$MOUNTDIR"
				uci -q set "fstab.@mount[$i].fstype=$FSTYPE"
				uci -q set "fstab.@mount[$i].enabled=$ON"
				break
			fi
			i=$((i+1))
		done

		if [ "$EXIST" = "0" ]; then
			# 找一个可用的索引（跳过 /overlay、/rom 这些系统项）
			IDX=0
			while uci -q get "fstab.@mount[$IDX]" >/dev/null 2>&1; do
				IDX=$((IDX+1))
			done
			uci -q add fstab mount
			uci -q set "fstab.@mount[$IDX].uuid=$FSUUID"
			uci -q set "fstab.@mount[$IDX].target=$MOUNTDIR"
			uci -q set "fstab.@mount[$IDX].fstype=$FSTYPE"
			uci -q set "fstab.@mount[$IDX].options=rw,relatime,ssd,discard=async"
			uci -q set "fstab.@mount[$IDX].enabled=$ON"
			log "已写入 fstab: $FSUUID -> $MOUNTDIR"
		else
			log "fstab 已有该 UUID 的挂载项，已更新"
		fi
		uci -q commit fstab

		# 清理可能存在的旧自定义 init 脚本（避免和 block 重复挂载）
		if [ -f /etc/init.d/storage ]; then
			/etc/init.d/storage disable >/dev/null 2>&1
			rm -f /etc/init.d/storage /etc/rc.d/*storage* 2>/dev/null
			log "已移除旧的自定义挂载脚本（改由 block 负责）"
		fi
	fi
fi

# ---------- 5) 立即挂载一次（本次开机就能用） ----------
mkdir -p "$MOUNTDIR"
if ! grep -q " $MOUNTDIR " /proc/mounts; then
	block mount >/dev/null 2>&1
	sleep 2
fi
if grep -q " $MOUNTDIR " /proc/mounts; then
	log "已挂载: $(df -h $MOUNTDIR 2>/dev/null | tail -1)"
else
	log "未挂载（可稍后手动处理）"
fi

exit 0
